# Shopify storefront origins allowed to call this Vercel proxy.
SHOPIFY_STORE_URL=https://yourstore.myshopify.com
SHOPIFY_CUSTOM_DOMAIN=https://www.yourdomain.com
# Optional extra origin for staging/testing.
ADDITIONAL_ALLOWED_ORIGIN=

# AstrologyAPI credentials. Keep these only in Vercel/server env vars.
ASTROLOGY_USER_ID=YOUR_ASTROLOGY_USER_ID
ASTROLOGY_API_KEY=YOUR_ASTROLOGY_API_KEY

# Use api_key for x-astrologyapi-key, or basic for Basic user_id:api_key auth.
ASTROLOGY_AUTH_MODE=api_key
ASTROLOGY_PDF_ENDPOINT=https://pdf.astrologyapi.com/v1/basic_horoscope_pdf

# Optional per-IP per-minute rate limit.
KUNDLI_RATE_LIMIT=10
